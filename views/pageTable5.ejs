<!DOCTYPE html>
<html lang="en">
<head>
    <link href="/css/bootstrap.min.css" rel="stylesheet" >
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@100;200;400&display=swap" rel="stylesheet">
    <link href="/manifest.json" rel="manifest" >
    <link rel="apple-touch-icon" sizes="266x196" href="/icons/LOGOUNO.png">
    <style>
      #ince {
            background-color: #80ced6 ;
            text-shadow: 0px 4px 3px rgba(0,0,0,0.4),
                 0px 8px 13px rgba(0,0,0,0.7),
                 0px 18px 23px rgba(0,0,0,0.4);
      }
      *{
            padding: 0;
            box-sizing: border-box;
            font-family: 'Kanit', sans-serif;
        }
        @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px) {
        }
        table , tr , td{
          border:1px solid black;
        }
        #sale-text{
          padding-left:50px;
          margin-right:50px;
        }
        .flex {
          display: flex;
          /* border: 1px solid black; */
          margin: 5px;
          padding: 5px;
        }
  </style>
<head>
	<script src="/js/bootstrap.min.js" ></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
  <title>Test Database Server</title>
</head>
<body>
  <div class="pic">
  <nav id = "ince" class="navbar navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/users/pageOne" style="font-family: Lato;">
          <img src="/icons/logo-header2.png" alt="" width="40" height="35"> UNOGROUP
      </a>
    </div>
  </nav>
  <img src="/icons/LOGOUNO.png" class="rounded mx-auto my-5 d-block" alt="..."width="300" height="200">
</div> 
  <div class = "d-flex flex-row  mb-3 mr-2" >
    <h2  id = "sale-text"class = "mr-3 flex-fill">ยอดรายงานการขาย ประจำวันที่ </h2>
    <form action="/users/pageTwo/pageTable1" method="POST" class="validated-form" validate>
      <div class="flex">
        <input type="text" id = "datefilter" name="datefilter" style="width:250px;"/>
          <button type = "submit" class="btn btn-warning">Search</button>
        
      </div>  
    </form>
  </div>
  <table class="table">
    <thead>
      <tr class="table borderTable" style = "background-color:#008080;color:white;"> 
          <th style="text-align:center;" scope="col ">Row Number</th>
          <th scope="col">Cust Code</th>
          <th scope="col">CustName2</th>
          <th scope="col">Net Amt</th>
          <th scope="col">PB</th>
          <th scope="col">CUMS</th>
          <th scope="col">MaxCr</th>
      </tr>
    </thead>
    <%
      if(testData.length!=0){
      var i=1;
      testData.forEach(function(data){
    %>
    <tr class="table" style="background-color: #F0FFF0;">
        <td style="text-align:center;"><%=i; %></td>
        <td><%=data.custCode%></td>
        <td><a href = "/users/pageTwo/subTable2?customer=<%=data.custCode%>"> <%=data.custName2%></a></td>
        <td><%=data.NetAmt%></td>
        <td><%=data.PB%></td>
        <td><%=data.CUMS%></td>
        <td><%=data.MaxCr%></td>
    </tr>
    <%  i++; }) %>
    <% } else{ %>
    <tr>
      <td colspan="7">No Data Found</td>
    </tr>
    <% } %>
</table>
</div>
</body>
<script>
$(function() {
  $('input[name="datefilter"]').daterangepicker({
    autoUpdateInput: false,
    locale: {
        cancelLabel: 'Clear'
    }
  });
  $('input[name="datefilter"]').on('apply.daterangepicker', function(ev, picker) {
    $(this).val(picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY'));
  });
  $('input[name="datefilter"]').on('cancel.daterangepicker', function(ev, picker) {
    $(this).val('');
  });
});
</script>
</html>