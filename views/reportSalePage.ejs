<p class="h2" style="text-align:center;font-weight: bold;">ชื่อ พนักงาน&ensp;<%=surName%>&ensp;<%=lastName%></p>
 
  <table id="example" class="table display nowrap" style="width:100%">
    <thead >
      <tr class="table borderTable " style = "background-color:#008080;color:white;"> 
          <!-- <th style="text-align:center;width:5%;" scope="col">Row Number</th> -->
          <th scope="col">รหัสลูกค้า</th>
          <th scope="col">ชื่อ</th>
          <th  scope="col">ยอดขายรวม</th>
          <th scope="col">CU</th>
          <th scope="col">MS</th>
          <th scope="col">PB รวม</th>
          <th scope="col">ยอดขาย ยาปกติ</th>
          <th  scope="col">CUMS ยาปกติ</th>
          <th  scope="col">PB ยาปกติ</th>
          <th scope="col">ยอดขาย ยาพิเศษ</th>
          <th  scope="col">CUMS ยาพิเศษ</th>
          <th scope="col">PB ยาพิเศษ</th>
      </tr>
    </thead>  
    
    <%
      if(testData.length!=0){
      var i=1;
      testData.forEach(function(data){
          
    %>
    <tr class="table" style="background-color: #F0FFF0;">
        <!-- <td style="text-align:center;"><%=i; %></td> -->
        <td style = "width:12%;"><%=data.custCode%></td>
        <td><%=data.custName%></td>
        <td><%=x(data.NetOne)%></a></td>
        <td><%=x(data.CuOne)%></td>
        <td><%=x(data.msOne)%></td>
        <td><%=x(data.PBOne)%></td>
        <td><%=x(data.NetTwo)%></td>
        <td><%=x(data.cumsTwo)%></td>
        <td><%=x(data.PBTwo)%></td>
        <td><%=x(data.NetThree)%></td>
        <td><%=x(data.CUMSThree)%></td>
        <td><%=x(data.PBThree)%></td>
    </tr>
    <%  i++; }) %>
    <% } else{ %>
    <tr>
      <td style = "width:12%;">-</td>
      <td>0.00</td>
      <td>0.00</a></td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
      <td>0.00</td>
    </tr>
    <% } %>
