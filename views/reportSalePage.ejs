  <%

  const x = (number)=>{
              if(number !=null){
                 
                  number = number.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                  return number;
  %> 
   <%           }else{  %>
      <%
                  return ' ';
              }
          }
      %>   
