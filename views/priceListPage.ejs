          table[tableNum+9].innerHTML =  arrSecondAfterMinusVal[tableNum+9];
          table[tableNum+10].innerHTML =   arrSecondAfterMinusVal[tableNum+10];
          table[tableNum+11].innerHTML =  arrSecondAfterMinusVal[tableNum+11];
          table[tableNum+12].innerHTML =  arrSecondAfterMinusVal[tableNum+12];

        }else if(arrValue[c-1] == 1 && arrCountValue[c-1]  == undefined){
          valuePoint[c-1].innerHTML = "1";

          table[tableNum+5].innerHTML =  arrOne[tableNum+5];
          table[tableNum+6].innerHTML =  arrOne[tableNum+6];
          table[tableNum+7].innerHTML =  arrOne[tableNum+7];
          table[tableNum+8].innerHTML =  arrOne[tableNum+8];
          table[tableNum+9].innerHTML =  arrOne[tableNum+9];
          table[tableNum+10].innerHTML =   arrOne[tableNum+10];
          table[tableNum+11].innerHTML =  arrOne[tableNum+11];
          table[tableNum+12].innerHTML =  arrOne[tableNum+12];
        }
      }
      tableNum +=15;
    }

  }
 

