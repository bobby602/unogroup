<!DOCTYPE html>
<html lang="en">
  <meta name="viewport" content="width=device-width,height=device-height,initial-scale=1.0"/>
<meta name = "apple-mobile-web-app-capable" content = "yes">
<meta name = "apple-mobile-web-app-status-bar-style" content = "black">
<head>
    <link href="/css/bootstrap.min.css" rel="stylesheet" >
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@100;200;400&display=swap" rel="stylesheet">
    <link href="/manifest.json" rel="manifest" >
    <link rel="apple-touch-icon" sizes="266x196" href="/icons/LOGOUNO.png">
    
    <style>
      #ince {
            background-color: #80ced6 ;
            text-shadow: 0px 4px 3px rgba(0,0,0,0.4),
                 0px 8px 13px rgba(0,0,0,0.7),
                 0px 18px 23px rgba(0,0,0,0.4);
      }
      *{
            padding: 0;
            box-sizing: border-box;
            font-family: 'Kanit', sans-serif;
        }
        @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px) {
        }
        table , tr , td{
          border:1px solid black;
        }
        #sale-text{
          padding-left:50px;
          margin-right:50px;
          text-align: center;
        }
        .h1{
            text-align: center;
        }
        .point{
          background-color:orange!important;
        }
        .sum{
            color:blue;
        }
  </style>
  <%

  const x = (number)=>{
              if(number !=null){
                  number = number.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                  return number;
  %> 
   <%           }else{  %>
      <%
                  return '0.00';
              }
          }
      %>   
<head>
  <script src="/js/bootstrap.min.js" ></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
  <link rel="stylesheet" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css">
  <script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js" ></script>
  <script src="https://code.jquery.com/jquery-3.5.1.js" ></script>
  <script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js" ></script>
  <title>PriceList</title>
</head>
<body>
    <div class="pic">
        <nav id = "ince" class="navbar navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand" href="/users/pageOne" style="font-family: Lato;">
                    <img src="/icons/logo-header2.png" alt="" width="40" height="35"> UNOGROUP
                </a>
            </div>
        </nav>
    
        <img src="/icons/LOGOUNO.png" class="rounded mx-auto my-5 d-block" alt="..." width="300" height="200">
    </div> 

    <div class = "d-flex  align-items: center flex-row mb-3 mr-1" >
      <h2 id = "sale-text"class = "mr-1 text-center">UNO GROUP</h2><br>
      <h2 id = "sale-text"class = "mr-1">PriceList ประจำเดือน <%=monthFil%>&ensp;&ensp; <%=yearThai%></h2> <br>
      <h2 id = "sale-text"class = "mr-1">ครั้งที่ 03</h2><br>
    </div>
    <%
    let arr = [];
    for(var i = 0; i< dataNameCat.length;i++){ 
    %>
      <div  class="d-flex  align-items: center flex-row p-1 mb-2 text-dark">
        <table id='table' class="table display nowrap" style="width:100%">
          <thead >
            <tr class="table borderTable bg-warning " style = "color:white;"> 
              <!-- <th style="text-align:center;width:5%;" scope="col">Row Number</th> -->
              <th scope="col"><%=dataNameCat[i].NameCat%></th>
          </tr>
            <tr class="table borderTable " style = "background-color:#008080;color:white;"> 
                <!-- <th style="text-align:center;width:5%;" scope="col">Row Number</th> -->
                <th scope="col">ชื่อสามัญ</th>
                <th scope="col">แพ็คกิ้ง</th>
                <th scope="col">แต้ม</th>
                <th scope="col">ขนาดบรรจุ</th>
                <th scope="col">Price</th>
                <th scope="col">Price25</th>
                <th scope="col">Price50</th>
                <th scope="col">Price100</th>
                <th scope="col">Price120</th>
                <th scope="col">Price240</th>
                <th scope="col">Price360</th>
                <th scope="col">Price600</th>
                <th scope="col">Note</th>
            </tr>
          </thead>  
            <%
            for(var j = 0; j< dataSName.length;j++){        
            %>  
                <tr class="table" style="background-color: #F0FFF0;">
                  <td class="table borderTable " style = "background-color:white;color:black;width:12%;"><%=dataSName[j].Name%></td>
                  <td class="table borderTable " style = "background-color:white;color:black;width:12%;"><%=dataSName[j].NoteF%></td>
                  <td class="table borderTable " style = "background-color:white;color:black;width:12%;"><%=dataSName[j].Point%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=dataSName[j].Package%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Pricelist)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Price25)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Price50)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Price100)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Price120)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Price240)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Price360)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=x(dataSName[j].Price600)%></td>
                  <td class="table borderTable "  style = "background-color:white;color:black;width:12%;"><%=dataSName[j].Note%></td>
                </tr>
            <% } %>
        </table>
      </div>
    <% } %>

</body>
<script>
    let date1 = new Date();
  $(document).ready(function () {
    $('table').DataTable({
      paging: false,
      info: false,
      ordering: false,
      scrollY: true,
      scrollX: true,
    });
  });
 
</script>

</html>