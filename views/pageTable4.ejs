<!DOCTYPE html>
<html lang="en">
<head>
    <link href="/css/bootstrap.min.css" rel="stylesheet" >
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@100;200;400&display=swap" rel="stylesheet">
    <link href="/manifest.json" rel="manifest" >
    <link rel="apple-touch-icon" sizes="266x196" href="/icons/LOGOUNO.png">
    
    <style>
      #ince {
            background-color: #80ced6 ;
            text-shadow: 0px 4px 3px rgba(0,0,0,0.4),
                 0px 8px 13px rgba(0,0,0,0.7),
                 0px 18px 23px rgba(0,0,0,0.4);
      }
      *{
            padding: 0;
            box-sizing: border-box;
            font-family: 'Kanit', sans-serif;
        }
        @media only screen 
        and (min-device-width : 768px) 
        and (max-device-width : 1024px) {
        }
        table , tr , td{
          border:1px solid black;
        }
        #sale-text{
          padding-left:50px;
          margin-right:50px;
        }
    </style>
<head>
  <script src="/js/bootstrap.min.js" ></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
  <link rel="stylesheet" href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css">
  <script src="https://cdn.datatables.net/1.10.19/js/jquery.dataTables.min.js" ></script>
  <script src="https://code.jquery.com/jquery-3.5.1.js" ></script>
  <script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js" ></script>
  <title>UnoGroup</title>
</head>
<body>
    <%
    const x = (number)=>{
                if(number !=null){
                   
                    number = number.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                    return number;
    %> 
     <%           }else{  %>
        <%
                    return ' ';
                }
            }
        %>   
  <div class="pic">
  <nav id = "ince" class="navbar navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/users/pageOne" style="font-family: Lato;">
          <img src="/icons/logo-header2.png" alt="" width="40" height="35"> UNOGROUP
      </a>
    </div>
  </nav>
  <img src="/icons/LOGOUNO.png" class="rounded mx-auto my-5 d-block" alt="..."width="300" height="200">
</div> 
  <table id="example" class="table display nowrap" style="width:100%">
    <thead>
      <tr class="table borderTable" style = "background-color:#008080;color:white;"> 
          <th style="width:15%;text-align:center;" scope="col">พนักงาน</th>
          <th style="width:10%;text-align:center;" scope="col">Type</th>
          <th style="text-align:center;" scope="col">มค.</th>
          <th style="text-align:center;" scope="col">กพ.</th>
          <th style="text-align:center;" scope="col">มีค.</th>
          <th style="text-align:center;" scope="col">เมย.</th>
          <th style="text-align:center;" scope="col">พค.</th>
          <th style="text-align:center;" scope="col">มิย.</th>
          <th style="text-align:center;" scope="col">กค.</th>
          <th style="text-align:center;" scope="col">สค.</th>
          <th style="text-align:center;" scope="col">กย.</th>
          <th style="text-align:center;" scope="col">ตค.</th>
          <th style="text-align:center;" scope="col">พย.</th>
          <th style="text-align:center;" scope="col">ธค.</th>
      </tr>
    </thead>  
    <%
      if(newPerson.length!=0){
      var num = 1;
      var i=1;
      newPerson.forEach(function(data){
    %>
    <tr class="table" style="background-color: #F0FFF0;">
        <% if(i == 1 || i %4 ==1 ) { %>
          <td style="text-align:center;"><%=data.NameG%></td>
        <% }else{ %>
          <td></td>
        <% } %>  
        <td style="text-align:center;"><%=data.PBType;%></td>
        <td><%=x(data.one)%></td>
        <td><%=x(data.two)%></td>
        <td><%=x(data.third)%></td>
        <td><%=x(data.fourth)%></td>
        <td><%=x(data.fifth)%></td>
        <td><%=x(data.six)%></td>
        <td><%=x(data.seven)%></td>
        <td><%=x(data.eight)%></td>
        <td><%=x(data.nine)%></td>
        <td><%=x(data.ten)%></td>
        <td><%=x(data.eleven)%></td>
        <td><%=x(data.twelve)%></td>
    </tr>
    <%  i++; }) %>
    <% } else{ %>
    <tr>
      <td colspan="7">No Data Found</td>
    </tr>
    <% } %>
</table>

</div>

</body>
<style>
  div.dataTables_wrapper {
    width: 100%;
    height:100%;
    margin: 0 auto;
}
</style>
<script>
  $(document).ready(function () {
    $('#example').DataTable({
      paging: false,
      info: false,
        ordering: false,
        scrollY: true,
        scrollX: true,
    });
  });
</script>
</html>